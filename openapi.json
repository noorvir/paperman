  "components": {
    "schemas": {
      "ActionResult": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ActionResult"
      },
      "Analysis-Input": {
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentProposal-Input"
            },
            "type": "array",
            "minItems": 1,
            "title": "Documents"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "documents"
        ],
        "title": "Analysis"
      },
      "Analysis-Output": {
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentProposal-Output"
            },
            "type": "array",
            "minItems": 1,
            "title": "Documents"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "documents"
        ],
        "title": "Analysis"
      },
      "Body_upload": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload"
      },
      "Catalog": {
        "properties": {
          "owners": {
            "items": {
              "$ref": "#/components/schemas/CatalogEntry"
            },
            "type": "array",
            "title": "Owners"
          },
          "tags": {
            "items": {
              "$ref": "#/components/schemas/CatalogEntry"
            },
            "type": "array",
            "title": "Tags"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "owners",
          "tags"
        ],
        "title": "Catalog"
      },
      "CatalogEntry": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "aliases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Aliases"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "aliases"
        ],
        "title": "CatalogEntry"
      },
      "Dashboard": {
        "properties": {
          "documents": {
            "type": "integer",
            "title": "Documents"
          },
          "pending": {
            "type": "integer",
            "title": "Pending"
          },
          "review": {
            "type": "integer",
            "title": "Review"
          },
          "failed": {
            "type": "integer",
            "title": "Failed"
          },
          "enrichment_failed": {
            "type": "integer",
            "title": "Enrichment Failed"
          },
          "worker": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkerState"
              },
              {
                "type": "null"
              }
            ]
          },
          "worker_online": {
            "type": "boolean",
            "title": "Worker Online"
          },
          "ocr_available": {
            "type": "boolean",
            "title": "Ocr Available"
          },
          "model_configured": {
            "type": "boolean",
            "title": "Model Configured"
          },
          "inbox_path": {
            "type": "string",
            "title": "Inbox Path"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "documents",
          "pending",
          "review",
          "failed",
          "enrichment_failed",
          "worker",
          "worker_online",
          "ocr_available",
          "model_configured",
          "inbox_path"
        ],
        "title": "Dashboard"
      },
      "Document": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$",
            "title": "Id"
          },
          "scan_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$",
            "title": "Scan Id"
          },
          "source_pages": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Source Pages"
          },
          "owner_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$",
            "title": "Owner Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "document_date": {
            "type": "string",
            "format": "date",
            "title": "Document Date"
          },
          "date_source": {
            "type": "string",
            "enum": [
              "document",
              "scan_fallback"
            ],
            "title": "Date Source"
          },
          "scanned_at": {
            "type": "string",
            "format": "date-time",
            "title": "Scanned At"
          },
