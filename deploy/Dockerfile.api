FROM python:3.13-slim
COPY --from=ghcr.io/astral-sh/uv:0.12.1 /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng tesseract-ocr-deu && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY apps/server/pyproject.toml apps/server/uv.lock ./apps/server/
COPY apps/server/paperman ./apps/server/paperman
COPY packages/parser/pyproject.toml ./packages/parser/
COPY packages/parser/paperman_parser ./packages/parser/paperman_parser
RUN uv sync --project apps/server --frozen --no-dev
ENV PATH="/app/apps/server/.venv/bin:$PATH" PAPERMAN_DATA_DIR=/data PYDANTIC_AI_NO_BANNER=1
CMD ["paperman", "serve", "--host", "0.0.0.0"]
