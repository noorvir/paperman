PAPERMAN_DATA_DIR=./data
# For Compose, use an existing absolute path with service-user write access.
# PAPERMAN_DATA_DIR=/path/to/paperman-data
# PAPERMAN_UID=1000
# PAPERMAN_GID=1000
# PAPERMAN_MODEL_API_KEY=local

# Authentication is optional. Set the same flag and API secret on web and API.
PAPERMAN_AUTH_ENABLED=false
# PAPERMAN_AUTH_URL=https://paperman.example.com
# PAPERMAN_AUTH_DATABASE=/absolute/path/to/auth.sqlite
# PAPERMAN_AUTH_SECRET=<random secret, at least 32 characters>
# PAPERMAN_API_AUTH_SECRET=<different random secret, at least 32 characters>
